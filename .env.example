# ============================================================================
# Direcciones reales de los componentes
# ----------------------------------------------------------------------------
# El gateway corre en el contenedor "api-gateway", solo en la red "acb-net".
# Los servicios Java se unen a acb-net con alias DNS para el despliegue TLS.
#
# Componente        Contenedor            Host              Interno
# auth              acb_auth              localhost:8084    8084
# admin_users       acb_admin_users       localhost:8083    8083
# admin_operation   acb_admin_operation   localhost:8081    8081
# admin_routes      acb_admin_routes      localhost:8082    8082
# paths (geoloca)   acb_path_lo           localhost:8000    8000  (alias acb-net: geoloca-api)
# gps               acb_gps_lo            localhost:8079    8080  (alias acb-net: geoloca-gps)
# api-gateway       api-gateway           localhost:5062    5062
# ============================================================================

AUTH_SERVICE_URL=https://acb-auth:8084
USERS_SERVICE_URL=https://acb-users:8083
OPERATIONS_SERVICE_URL=https://acb-operations:8081
ROUTES_SERVICE_URL=https://acb-routes:8082

# Servicios de geolocalizacion, resueltos por su alias dentro de acb-net.
GPS_SERVICE_URL=https://geoloca-gps:8080
PATHS_SERVICE_URL=https://geoloca-api:8000

# --- Alternativa para ejecutar el gateway en local (npm run dev) ---
# AUTH_SERVICE_URL=https://localhost:8084
# USERS_SERVICE_URL=https://localhost:8083
# OPERATIONS_SERVICE_URL=https://localhost:8081
# ROUTES_SERVICE_URL=https://localhost:8082
# GPS_SERVICE_URL=https://localhost:8079
# PATHS_SERVICE_URL=https://localhost:8000

# Credencial interna de servicio para control/lectura del GPS.
# Mismo valor que GPS_GATEWAY_INTERNAL_TOKEN en geolocaACB/.env.
# Perfil de laboratorio P3: completar este valor sólo en .env local.
# GPS_CONTROL_CREDENTIAL_KEY de Go debe ser diferente; no se configura aquí.
GPS_INTERNAL_TOKEN=

# Firma HS256 compartida con adminACB; debe coincidir con la de Java.
# Autoriza creación, lectura y cierre de sesiones de seguimiento.
ACB_JWT_SECRET=

# Política sintética de laboratorio definida en
# geolocaACB/acb_gps_lo/config/tracking-policies.yaml.
# Gateway la impone al crear la sesión; el navegador no puede sustituirla.
GPS_POLICY_ID=demo-school-v1

# Compose P3 configura estos archivos montados desde ACB_TLS_DIR externo.
# Para ejecutar Gateway sin Compose, definir ambos archivos de servidor y la CA.
# Si no se definen los dos primeros, npm start conserva HTTP heredado.
# ACB_TLS_CERT_FILE=/ruta/externa/gateway.crt
# ACB_TLS_KEY_FILE=/ruta/externa/gateway.key
# NODE_EXTRA_CA_CERTS=/ruta/externa/ca.crt

# ============================================================================
# Contrato publico del gateway
# ----------------------------------------------------------------------------
# /api/v1/auth, /api/v1/{guides,students,search}   -> auth + admin_users
# /api/v1/admin/*                                  -> admin_routes + admin_operations
# /api/v1/{routes,meeting-points,imports,status}   -> acb_path_lo (Python)
# /api/v1/tracking-sessions/*                      -> acb_gps_lo (Go)
#
# El tracking GPS se atiende EXCLUSIVAMENTE con el componente Go. Los routers
# de tracking de acb_path_lo son legado obsoleto y el gateway no los usa.
# Nginx de presentationACB reescribe:
#   /api/admin/* -> /api/v1/admin/*
#   /api/geo/*   -> /api/v1/*
# ============================================================================

# No se lee en el codigo actual; los repositorios llaman siempre a los reales.
USE_MOCK_SERVICES=false

# Rate limiting (ventana fija, contadores compartidos entre workers del cluster).
# Duracion de la ventana en milisegundos.
RATE_LIMIT_WINDOW_MS=60000
# Solicitudes por cliente (usuario JWT, sesion de tracking o IP) por ventana.
RATE_LIMIT_MAX=120
# Intentos de login por IP + usuario por ventana.
RATE_LIMIT_LOGIN_MAX=5
# Proxies cuya cabecera X-Forwarded-For se acepta (Nginx y BFF en red privada).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Puerto de la API Gateway
PORT=5062
