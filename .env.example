# ============================================================================
# Direcciones reales de los componentes
# ----------------------------------------------------------------------------
# El gateway corre en el contenedor "api-gateway", solo en la red "acb-net".
# Los servicios de adminACB no estan en acb-net: se alcanzan por el host
# (host.docker.internal) y su puerto publicado.
#
# Componente        Contenedor            Host              Interno
# auth              acb_auth              localhost:8084    8084
# admin_users       acb_admin_users       localhost:8083    8083
# admin_operation   acb_admin_operation   localhost:8081    8081
# admin_routes      acb_admin_routes      localhost:8082    8082
# paths (geoloca)   acb_path_lo           localhost:8000    8000  (alias acb-net: geoloca-api)
# gps               acb_gps_lo            localhost:8079    8080  (alias acb-net: geoloca-gps)
# api-gateway       api-gateway           localhost:5062    5062
# ============================================================================

AUTH_SERVICE_URL=http://host.docker.internal:8084
USERS_SERVICE_URL=http://host.docker.internal:8083
OPERATIONS_SERVICE_URL=http://host.docker.internal:8081
ROUTES_SERVICE_URL=http://host.docker.internal:8082

# Servicios de geolocalizacion, resueltos por su alias dentro de acb-net.
GPS_SERVICE_URL=http://geoloca-gps:8080
PATHS_SERVICE_URL=http://geoloca-api:8000

# --- Alternativa para ejecutar el gateway en local (npm run dev) ---
# AUTH_SERVICE_URL=http://localhost:8084
# USERS_SERVICE_URL=http://localhost:8083
# OPERATIONS_SERVICE_URL=http://localhost:8081
# ROUTES_SERVICE_URL=http://localhost:8082
# GPS_SERVICE_URL=http://localhost:8079
# PATHS_SERVICE_URL=http://localhost:8000

# No se lee en el codigo actual; los repositorios llaman siempre a los reales.
USE_MOCK_SERVICES=false

# Puerto de la API Gateway
PORT=5062
